#! sampling the sample points using Fibonacci spiral evaluated via mpmath
#:include '../src/common.fypp'
"""
Generate the mpmath-based high-precision reference data for the
complex-valued Legendre polynomial comparison (example/).

Usage:
    fypp example/mpmath_complex.fypp example/mpmath_complex.py
    python3 example/mpmath_complex.py > example/mpmath_complex.dat

The working precision (mp.prec) is not a fixed constant: this script
starts at PREC_START and doubles it until the generated output text
stops changing (is identical to the previous, half-precision run),
then emits that converged output. This makes the precision choice
self-verifying rather than a hand-picked number, and it is re-derived
automatically if NUM_POINTS, MAXVAL_DEGREE_INTERFACE or NSTR_DIGITS
changes later.

Note: this convergence check is not a rigorous precision guarantee.
mpmath here uses ordinary (non-interval) multiple-precision binary
floating-point arithmetic; the output text becoming stable across a
doubling of mp.prec is empirical evidence that rounding error is no
longer visible at the requested output precision, not a certified
error bound. It is not based on interval arithmetic.
"""

# standard library
import sys

# third-party library
import mpmath

NUM_POINTS: int = 2048
MAXVAL_DEGREE_INTERFACE: int = ${MAXVAL_DEGREE_INTERFACE}$
NSTR_DIGITS: int = 39

PREC_START: int = 64
PREC_MAX: int = 1 << 16  # safety cap; convergence is expected well below this


def generate(prec: int) -> str:
    """Generate the reference data text for the given working precision."""
    with mpmath.workprec(prec):

        golden_angle: mpmath.mpf = \
            mpmath.mp.pi * (mpmath.mpf(3) - mpmath.sqrt(5))

        lines: list[str] = []

        for i in range(1, NUM_POINTS + 1):
            radius: mpmath.mpf = \
                mpmath.sqrt(mpmath.mpf(i) / mpmath.mpf(NUM_POINTS))

            angle: mpmath.mpf = i * golden_angle

            z: mpmath.mpc = radius * mpmath.exp(angle * 1j)

            str_real_part: str = ""
            str_imag_part: str = ""

            for degree in range(MAXVAL_DEGREE_INTERFACE + 1):
                lp = mpmath.legendre(degree, z)

                str_real_part += ' ' + mpmath.nstr(lp.real, NSTR_DIGITS)
                str_imag_part += ' ' + mpmath.nstr(lp.imag, NSTR_DIGITS)

            lines.append(
                mpmath.nstr(z.real, NSTR_DIGITS) + '  ' +
                mpmath.nstr(z.imag, NSTR_DIGITS) +
                str_real_part + str_imag_part
            )

        return '\n'.join(lines) + '\n'


def generate_converged(prec_start: int = PREC_START,
                       prec_max: int = PREC_MAX) -> str:
    """Double mp.prec from `prec_start` until the generated output text
    is identical to the previous (half-precision) run, then return
    that converged output. Each step is reported on stderr so the
    convergence point is visible when this script is run.

    This is an empirical convergence check, not a proven error bound:
    text becoming stable across a doubling of mp.prec means no further
    rounding-driven change was observed at NSTR_DIGITS output digits.
    It is not based on interval arithmetic.
    """
    if prec_start <= 0:
        raise ValueError("prec_start must be positive integer")

    if prec_max < prec_start:
        raise ValueError("prec_max must be greater than prec_start")

    prev_text: str | None = None

    prec: int = prec_start
    last_tested_prec: int = prec_start

    while prec <= prec_max:

        text = generate(prec)

        print(f"prec={prec:6d} bit  "
              f"{'unchanged' if text == prev_text else 'changed'}",
              file=sys.stderr)

        if text == prev_text:
            return text

        prev_text = text

        last_tested_prec = prec
        prec *= 2

    # `prec` may have overshot `prec_max` here (it keeps doubling from
    # `prec_start`, which need not divide `prec_max` evenly), so report
    # the last precision actually tested rather than `prec_max` itself.
    raise RuntimeError(
        f"output did not converge by prec={last_tested_prec} bit "
        f"(prec_max={prec_max} bit)"
    )


if __name__ == "__main__":
    sys.stdout.write(generate_converged())
