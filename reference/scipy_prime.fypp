#! The derivative is evaluated with the identity
#! P_n'(x) = n (P_{n-1}(x) - x P_n(x)) / (1 - x^2)  ( |x| < 1 ),
#! which needs only scipy.special.eval_legendre.
#:include '../src/common.fypp'
#:set NUM_POINTS = 8
#:set STEP_X = 1.0 / NUM_POINTS
#:for RANGE_X in range(1, NUM_POINTS)
#:set X = STEP_X * RANGE_X
#:for DEGREE in range( 0, (MAXVAL_DEGREE_INTERFACE_PRIME + 1) )
#:if DEGREE == 0
${DEGREE}$ ${X}$ 0.0
#:else
${DEGREE}$ ${X}$ ${DEGREE * (scipy.special.eval_legendre(DEGREE - 1, X) - X * scipy.special.eval_legendre(DEGREE, X)) / (1.0 - X * X)}$
#:endif
#:endfor
#:endfor
