#:mute

#:include '../src/common.fypp'

#:set PROGRAM_NAME = 'check_update_interval_invalid_degree'

#:def GENERATE_SUBROUTINE_NAME(real_kind)
${PROGRAM_NAME}$_real${str(real_kind)}$
#:enddef GENERATE_SUBROUTINE_NAME

#:endmute
program ${PROGRAM_NAME}$

  use, intrinsic :: iso_fortran_env, only: error_unit
  use, intrinsic :: iso_fortran_env, only: int32
  #:for REAL_KIND in REAL_KINDS
  use, intrinsic :: iso_fortran_env, only: real${REAL_KIND}$
  #:endfor

  use, intrinsic :: ieee_arithmetic, only: ieee_is_nan

  use, non_intrinsic :: ${MODULE_NAME_BISECTION_METHOD}$, only: ${UPDATE_INTERVAL_BY_BISECTION_METHOD_SELECTABLE_INTERFACE}$



  implicit none



  #:for REAL_KIND in REAL_KINDS
  call ${GENERATE_SUBROUTINE_NAME(REAL_KIND)}$()
  #:endfor

  print *, 'OK: ${PROGRAM_NAME}$'



  contains


  #:for REAL_KIND in REAL_KINDS

  #:set SUBROUTINE_NAME = GENERATE_SUBROUTINE_NAME(REAL_KIND)
  subroutine ${SUBROUTINE_NAME}$()

    integer(int32), parameter :: maxval_degree = ${MAXVAL_DEGREE_REAL(REAL_KIND)}$


    integer(int32) :: degree

    real(real${REAL_KIND}$) :: x_lower, x_upper, p_n_lower, p_n_upper


    do degree = (-10_int32 * maxval_degree), (10_int32 * maxval_degree)

      select case (degree)

        case (1_int32:maxval_degree)

          cycle

        case default

          call random_number(x_lower)
          call random_number(x_upper)
          call random_number(p_n_lower)
          call random_number(p_n_upper)

          call ${UPDATE_INTERVAL_BY_BISECTION_METHOD_SELECTABLE_INTERFACE}$(degree, x_lower, x_upper, p_n_lower, p_n_upper)

          if ( .not. all( ieee_is_nan( [x_lower, x_upper, p_n_lower, p_n_upper] ) ) ) then

            write(error_unit, *) 'n         : ', degree
            write(error_unit, *) 'x_lower   : ', x_lower
            write(error_unit, *) 'x_upper   : ', x_upper
            write(error_unit, *) 'p_n_lower : ', p_n_lower
            write(error_unit, *) 'p_n_upper : ', p_n_upper
            write(error_unit, *) 'These values must be NaN.'

            error stop

          end if

      end select

    end do

  end subroutine ${SUBROUTINE_NAME}$
  #:del SUBROUTINE_NAME

  #:endfor
  #! REAL_KIND
end program ${PROGRAM_NAME}$
