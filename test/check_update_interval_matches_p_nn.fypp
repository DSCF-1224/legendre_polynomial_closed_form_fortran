#:mute

#:include '../src/common.fypp'

#:set PROGRAM_NAME = 'check_update_interval_matches_p_nn'

#:def GENERATE_SUBROUTINE_NAME(real_kind)
${PROGRAM_NAME}$_real${str(real_kind)}$
#:enddef GENERATE_SUBROUTINE_NAME

#:endmute
program ${PROGRAM_NAME}$

  use, intrinsic :: iso_fortran_env, only: error_unit
  use, intrinsic :: iso_fortran_env, only: int32
  #:for REAL_KIND in REAL_KINDS
  use, intrinsic :: iso_fortran_env, only: real${REAL_KIND}$
  #:endfor

  use, non_intrinsic :: ${MODULE_NAME}$

  use, non_intrinsic :: ${MODULE_NAME_BISECTION_METHOD}$, only: ${UPDATE_INTERVAL_BY_BISECTION_METHOD_SELECTABLE_INTERFACE}$

  use, non_intrinsic :: test_utilities, only: is_equal



  implicit none



  integer, parameter :: num_trials = 100


  #:for REAL_KIND in REAL_KINDS
  call ${GENERATE_SUBROUTINE_NAME(REAL_KIND)}$()
  #:endfor

  print *, 'OK: ${PROGRAM_NAME}$'



  contains


  #:for REAL_KIND in REAL_KINDS

  #:set SUBROUTINE_NAME = GENERATE_SUBROUTINE_NAME(REAL_KIND)
  subroutine ${SUBROUTINE_NAME}$()
    !! The ends are random, so that the signs of the values at the ends are not restricted.


    integer(int32) :: degree

    integer :: i_trial

    real(real${REAL_KIND}$) :: x_a, x_b


    do degree = 1_int32, ${MAXVAL_DEGREE_REAL(REAL_KIND)}$_int32

      do i_trial = 1, num_trials

        call random_number(x_a) ! [0, 1)
        call random_number(x_b) ! [0, 1)

        x_a = 2.0_real${REAL_KIND}$ * x_a - 1.0_real${REAL_KIND}$ ! [-1, 1)
        x_b = 2.0_real${REAL_KIND}$ * x_b - 1.0_real${REAL_KIND}$ ! [-1, 1)

        block

          real(real${REAL_KIND}$) :: expected_x_a, actual_x_a, expected_p_n_a, actual_p_n_a
          real(real${REAL_KIND}$) :: expected_x_b, actual_x_b, expected_p_n_b, actual_p_n_b


          expected_x_a   = x_a
          expected_x_b   = x_b
          expected_p_n_a = ${P_N_SELECTABLE_INTERFACE}$(degree, x_a)
          expected_p_n_b = ${P_N_SELECTABLE_INTERFACE}$(degree, x_b)

          actual_x_a     = expected_x_a
          actual_x_b     = expected_x_b
          actual_p_n_a   = expected_p_n_a
          actual_p_n_b   = expected_p_n_b


          block

            real(real${REAL_KIND}$) :: x_middle, p_n_middle


            x_middle   = (x_a + x_b) * 0.5_real${REAL_KIND}$
            p_n_middle = ${P_N_SELECTABLE_INTERFACE}$(degree, x_middle)

            if ( abs(p_n_middle) <= 0.0_real${REAL_KIND}$ ) then

              expected_x_a   = x_middle
              expected_x_b   = x_middle
              expected_p_n_a = p_n_middle
              expected_p_n_b = p_n_middle

            else if ( (p_n_middle < 0.0_real${REAL_KIND}$) .eqv. (expected_p_n_a < 0.0_real${REAL_KIND}$) ) then

              expected_x_a   = x_middle
              expected_p_n_a = p_n_middle

            else

              expected_x_b   = x_middle
              expected_p_n_b = p_n_middle

            end if

          end block


          call ${UPDATE_INTERVAL_BY_BISECTION_METHOD_SELECTABLE_INTERFACE}$( &!
            degree, actual_x_a, actual_x_b, actual_p_n_a, actual_p_n_b &!
          )


          call check_equality_real${REAL_KIND}$( &!
            degree   = degree , &!
            x_a      = x_a    , &!
            x_b      = x_b    , &!
            expected = [ expected_x_a, expected_x_b, expected_p_n_a, expected_p_n_b ] , &!
            actual   = [   actual_x_a,   actual_x_b,   actual_p_n_a,   actual_p_n_b ]   &!
          )

        end block

      end do

    end do

  end subroutine ${SUBROUTINE_NAME}$
  #:del SUBROUTINE_NAME

  #:endfor
  #! REAL_KIND

  #:for REAL_KIND in REAL_KINDS

  #:set SUBROUTINE_NAME = 'check_equality_real' + str(REAL_KIND)
  subroutine ${SUBROUTINE_NAME}$(degree, x_a, x_b, expected, actual)

    integer(int32), intent(in) :: degree

    real(real${REAL_KIND}$), intent(in) :: x_a, x_b

    real(real${REAL_KIND}$), intent(in) :: expected(4), actual(4)


    integer :: i


    do i = 1, 4

      if ( is_equal(expected(i), actual(i)) ) cycle

      write(error_unit, *) 'degree, x_a, x_b   : ', degree, ',', x_a, ',', x_b
      write(error_unit, *) 'index of the value : ', i, ' ( 1: x_a, 2: x_b, 3: p_n_a, 4: p_n_b )'
      write(error_unit, *) 'expected           : ', expected(i)
      write(error_unit, *) 'actual             : ', actual(i)
      write(error_unit, *) 'These are must be equal.'

      error stop

    end do

  end subroutine ${SUBROUTINE_NAME}$
  #:del SUBROUTINE_NAME

  #:endfor
  #! REAL_KIND
end program ${PROGRAM_NAME}$
