#:mute

#:include '../src/common.fypp'

#:set PROGRAM_NAME = 'check_update_interval_until_convergence'

#:def GENERATE_SUBROUTINE_NAME(real_kind)
${PROGRAM_NAME}$_real${str(real_kind)}$
#:enddef GENERATE_SUBROUTINE_NAME

#:endmute
program ${PROGRAM_NAME}$
  !! The intervals of
  !! [legendre_polynomial_zero_intervals_fortran](https://github.com/DSCF-1224/legendre_polynomial_zero_intervals_fortran)
  !! are used as the initial intervals.
  !!
  !! The step is repeated until the interval converges,
  !! that is, until the ends are the same or adjacent floating-point numbers.

  use, intrinsic :: iso_fortran_env, only: error_unit
  use, intrinsic :: iso_fortran_env, only: int32
  #:for REAL_KIND in REAL_KINDS
  use, intrinsic :: iso_fortran_env, only: real${REAL_KIND}$
  #:endfor

  use, intrinsic :: ieee_arithmetic, only: ieee_is_nan, ieee_next_after

  use, non_intrinsic :: ${MODULE_NAME}$, only: ${P_N_SELECTABLE_INTERFACE}$

  use, non_intrinsic :: ${MODULE_NAME_BISECTION_METHOD}$, only: ${UPDATE_INTERVAL_BY_BISECTION_METHOD_SELECTABLE_INTERFACE}$

  use, non_intrinsic :: legendre_polynomial_zero_intervals_fortran, only: get_zero_interval



  implicit none



  #:for REAL_KIND in REAL_KINDS
  call ${GENERATE_SUBROUTINE_NAME(REAL_KIND)}$()
  #:endfor

  print *, 'OK: ${PROGRAM_NAME}$'



  contains


  #:for REAL_KIND in REAL_KINDS

  #:set SUBROUTINE_NAME = GENERATE_SUBROUTINE_NAME(REAL_KIND)
  subroutine ${SUBROUTINE_NAME}$()

    integer(int32), parameter :: maxval_degree = ${MAXVAL_DEGREE_REAL(REAL_KIND)}$

    !! The upper limit of the number of the steps.
    !! The interval is bisected by each step.
    !! The interval around the origin, which exists for every odd degree, requires the most steps,
    !! because its ends have to approach the origin down to the smallest positive number.
    !! The number of the bisections from the width 1 to the smallest positive number is ( digits - minexponent ).
    !! The limit is twice the sum of it and 2 as a margin.
    integer(int32), parameter :: max_steps = 2_int32 * ( digits(1.0_real${REAL_KIND}$) - minexponent(1.0_real${REAL_KIND}$) + 2_int32 )


    integer(int32) :: degree


    do degree = 1_int32, maxval_degree
    block

      real(real${REAL_KIND}$), dimension(degree) :: &!
        x_lower, p_n_lower, last_x_lower, &!
        x_upper, p_n_upper, last_x_upper


      block

        integer(int32) :: k, list_k(degree)


        list_k(:) = [( k, k = 1_int32, degree )]


        call get_zero_interval(   &!
          n       = degree      , &!
          k       = list_k  (:) , &!
          x_lower = x_lower (:) , &!
          x_upper = x_upper (:)   &!
        )

      end block

      p_n_lower(:) = ${P_N_SELECTABLE_INTERFACE}$( degree, x_lower(:) )
      p_n_upper(:) = ${P_N_SELECTABLE_INTERFACE}$( degree, x_upper(:) )


      call check_bracket_real${REAL_KIND}$( &!
        label     = 'initial'     , &!
        degree    = degree        , &!
        i_step    = 0_int32       , &!
        x_lower   = x_lower   (:) , &!
        x_upper   = x_upper   (:) , &!
        p_n_lower = p_n_lower (:) , &!
        p_n_upper = p_n_upper (:)   &!
      )


      block

        integer(int32) :: i_step

        logical, dimension(degree) :: flag_converged


        do i_step = 1_int32, max_steps

          last_x_lower(:) = x_lower(:)
          last_x_upper(:) = x_upper(:)

          call ${UPDATE_INTERVAL_BY_BISECTION_METHOD_SELECTABLE_INTERFACE}$( &!
            degree = degree        , &!
            x_a    = x_lower   (:) , &!
            x_b    = x_upper   (:) , &!
            p_n_a  = p_n_lower (:) , &!
            p_n_b  = p_n_upper (:)   &!
          )

          call check_bracket_real${REAL_KIND}$( &!
            label     = 'updated'     , &!
            degree    = degree        , &!
            i_step    = i_step        , &!
            x_lower   = x_lower   (:) , &!
            x_upper   = x_upper   (:) , &!
            p_n_lower = p_n_lower (:) , &!
            p_n_upper = p_n_upper (:)   &!
          )

          if ( any( x_lower(:) < last_x_lower(:) ) .or. any( last_x_upper(:) < x_upper(:) ) ) then

            write(error_unit, *) 'n, step : ', degree, ',', i_step
            write(error_unit, *) 'The interval must be included in the last interval.'

            error stop

          end if

          if ( any( abs( p_n_lower(:) - ${P_N_SELECTABLE_INTERFACE}$( degree, x_lower(:) ) ) > 0.0_real${REAL_KIND}$ ) .or. &!
              any( abs( p_n_upper(:) - ${P_N_SELECTABLE_INTERFACE}$( degree, x_upper(:) ) ) > 0.0_real${REAL_KIND}$ ) ) then

            write(error_unit, *) 'n, step : ', degree, ',', i_step
            write(error_unit, *) 'p_n_lower and p_n_upper must be the values at x_lower and x_upper.'

            error stop

          end if

          flag_converged(:) = &!
            ( abs( x_upper(:) - x_lower(:) ) <= 0.0_real${REAL_KIND}$ ) .or. &!
            ( abs( ieee_next_after( x_lower(:), x_upper(:) ) - x_upper(:) ) <= 0.0_real${REAL_KIND}$ )

          if ( all( flag_converged(:) ) ) exit

        end do

        if ( .not. all( flag_converged(:) ) ) then

          write(error_unit, *) 'n, steps : ', degree, ',', max_steps
          write(error_unit, *) 'The interval has not converged.'

          error stop

        end if

      end block

    end block
    end do

  end subroutine ${SUBROUTINE_NAME}$
  #:del SUBROUTINE_NAME

  #:endfor
  #! REAL_KIND

  #:for REAL_KIND in REAL_KINDS

  #:set SUBROUTINE_NAME = 'check_bracket_real' + str(REAL_KIND)
  subroutine ${SUBROUTINE_NAME}$(label, degree, i_step, x_lower, x_upper, p_n_lower, p_n_upper)
    !! The values at the ends must have different signs and be non-zero, or both be zero at the same point.

    character(*), intent(in) :: label

    integer(int32), intent(in) :: degree, i_step

    real(real${REAL_KIND}$), intent(in) :: x_lower(:), x_upper(:), p_n_lower(:), p_n_upper(:)


    logical, dimension(degree) :: flag, flag_bracket, flag_nan, flag_zero, flag_zero_p_n_lower, flag_zero_p_n_upper

    integer(int32) :: i


    flag_nan(:) = &!
      ieee_is_nan( x_lower(:) ) .or. ieee_is_nan( p_n_lower(:) ) .or. &!
      ieee_is_nan( x_upper(:) ) .or. ieee_is_nan( p_n_upper(:) )

    flag_zero_p_n_lower(:) = ( abs( p_n_lower(:) ) <= 0.0_real${REAL_KIND}$ )
    flag_zero_p_n_upper(:) = ( abs( p_n_upper(:) ) <= 0.0_real${REAL_KIND}$ )

    flag_zero(:) = &!
      flag_zero_p_n_lower(:) .and. &!
      flag_zero_p_n_upper(:) .and. &!
      ( abs( x_upper(:) - x_lower(:) ) <= 0.0_real${REAL_KIND}$ )

    flag_bracket(:) = &!
      ( ( p_n_lower(:) < 0.0_real${REAL_KIND}$ ) .eqv. ( 0.0_real${REAL_KIND}$ < p_n_upper(:) ) ) .and. &!
      ( ( p_n_upper(:) < 0.0_real${REAL_KIND}$ ) .eqv. ( 0.0_real${REAL_KIND}$ < p_n_lower(:) ) ) .and. &!
      ( .not. flag_zero_p_n_lower(:) ) .and. &!
      ( .not. flag_zero_p_n_upper(:) )

    flag(:) = ( flag_zero(:) .or. flag_bracket(:) ) .and. ( .not. flag_nan(:) )


    if ( all( flag(:) ) ) return


    do i = 1_int32, degree

      if ( flag(i) ) cycle

      write(error_unit, *) 'label, n, step : ', label, ',', degree, ',', i_step
      write(error_unit, *) 'index          : ', i
      write(error_unit, *) 'x_lower        : ', x_lower(i)
      write(error_unit, *) 'x_upper        : ', x_upper(i)
      write(error_unit, *) 'p_n_lower      : ', p_n_lower(i)
      write(error_unit, *) 'p_n_upper      : ', p_n_upper(i)
      write(error_unit, *) 'The signs of the values at the ends must be different.'

      error stop

    end do

  end subroutine ${SUBROUTINE_NAME}$
  #:del SUBROUTINE_NAME

  #:endfor
  #! REAL_KIND
end program ${PROGRAM_NAME}$
